<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aiec" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/aiec_cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Aiec.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/aiec_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Aiec</item>
    </style>
</resources>
